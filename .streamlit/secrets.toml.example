# COPIAR como .streamlit/secrets.toml en local.
# NUNCA subir secrets.toml a GitHub.
SUPABASE_URL = "https://TU-PROYECTO.supabase.co"
SUPABASE_SERVICE_ROLE_KEY = "TU-SERVICE-ROLE-SECRET"

# selector: solo elige un nombre (no verifica identidad).
# pin: exige además un PIN distinto por persona (recomendado para acceso real).
AUTH_MODE = "selector"

# Descomentar al activar AUTH_MODE = "pin" y cargar hashes de cada usuario.
# [PIN_HASHES]
# "Edwin Ramírez" = "pbkdf2_sha256$450000$SALT$HASH"
